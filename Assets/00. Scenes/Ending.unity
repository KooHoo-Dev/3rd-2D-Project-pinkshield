MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 206046626}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 182c6ec4c570fd1479253591bd0cc4b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::WatchYourBack.EndingDialogueUI
  sceneFadeIn: {fileID: 1044800297}
  playerImage: {fileID: 2040161961}
  darkermanImage: {fileID: 75678116}
  alleymanImage: {fileID: 923413205}
  watchmanImage: {fileID: 750243289}
  ratmanImage: {fileID: 985559817}
  speakerNameText: {fileID: 1342142051}
  dialogueText: {fileID: 483100163}
  playerDisplayName: Mahogany
  lines:
  - speaker: 1
    text: "\uC624\uB79C\uB9CC\uC774\uAD70\uC694 \uBCF4\uC2A4, \uC544\uB2C8 Mahogany."
  - speaker: 0
    text: "\uB300\uCCB4 \uC65C \uB098\uB97C \uBC30\uC2E0\uD55C\uAC70\uC9C0?"
  - speaker: 1
    text: "\uB2F9\uC2E0\uC740 \uC6B0\uB9B4 \uADF8\uB0E5 \uC545\uB2F9 \uCDE8\uAE09\uD588\uC9C0.
      \uB2E8 \uD55C\uBC88\uB3C4 \uCC59\uACA8\uC900\uC801\uC774 \uC5C6\uC5C8\uC5B4."
  - speaker: 0
    text: "\uBB50...?!?!"
  - speaker: 2
    text: "\uB09C \uC5EC\uAE30\uC11C \uB05D\uC5C6\uC774 \uC21C\uCC30\uB9CC \uD588\uC5B4."
  - speaker: 3
    text: "\uB09C \uC8C4\uC218 \uB140\uC11D\uB4E4\uC774 '\uD5E4\uC774!'\uB97C \uC678
      \uB54C\uB9C8\uB2E4 \uD655\uC778\uD558\uB7EC \uAC00\uC57C\uD588\uC9C0."
  - speaker: 4
    text: "\uB0B4 \uC950\uB4E4\uC744 \uC798\uB3C4 \uBC1F\uC544 \uC8FD\uC774\uB354\uAD70."
  - speaker: 1
    text: "\uB0B4 \uBD84\uC2E0\uB4E4\uACFC \uAC19\uC774 \uBC25 \uBA39\uC740\uC801\uC774
      \uC788\uC5C8\uB098?"
  - speaker: 0
    text: .....
  - speaker: 0
    text: "\uB0B4 \uC798\uBABB\uC774\uC5C8\uAD70. \uBBF8\uC548\uD558\uB2E4."
  gameClearMenu: {fileID: 459490142}
